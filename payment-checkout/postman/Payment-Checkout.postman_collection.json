{
  "info": {
    "_postman_id": "4d0e9f10-a9fa-4fd9-8e4e-33b173cd450b",
    "name": "Payment Checkout API",
    "description": "Colección para probar la API local de Payment Checkout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/1"
          }
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente de prueba\",\n  \"email\": \"cliente@ejemplo.com\",\n  \"phone\": \"3001234567\"\n}"
            },
            "url": "{{baseUrl}}/customers"
          }
        },
        {
          "name": "Create delivery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"Calle 1 # 2-3\",\n  \"city\": \"Bogotá\",\n  \"customerId\": 1\n}"
            },
            "url": "{{baseUrl}}/deliveries"
          }
        },
        {
          "name": "Create transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"productId\": 1, \"quantity\": 1 }],\n  \"customerId\": 1,\n  \"deliveryId\": 1,\n  \"customerEmail\": \"cliente@ejemplo.com\",\n  \"cardToken\": \"tok_test_...\",\n  \"installments\": 1,\n  \"reference\": \"checkout-001\",\n  \"acceptanceToken\": \"...\",\n  \"acceptPersonalAuth\": \"...\"\n}"
            },
            "url": "{{baseUrl}}/transactions"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions"
          }
        },
        {
          "name": "Get transaction",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions/1"
          }
        }
      ]
    }
  ]
}
